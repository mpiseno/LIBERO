(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the green cube and place it in the blue box)
    (:regions
      (cube_region
          (:target main_table)
          (:ranges (
              (-0.20 -0.20 0.15 -0.02)
            )
          )
      )
      (box_region
          (:target main_table)
          (:ranges (
              (-0.20 0.02 0.15 0.20)
            )
          )
      )
      (contain_region
          (:target blue_box_1)
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    green_cube_1 - green_cube
    blue_box_1 - blue_box
  )

  (:obj_of_interest
    green_cube_1
    blue_box_1
  )

  (:init
    (On green_cube_1 main_table_cube_region)
    (On blue_box_1 main_table_box_region)
  )

  (:goal
    (And (In green_cube_1 blue_box_1_contain_region))
  )

)
