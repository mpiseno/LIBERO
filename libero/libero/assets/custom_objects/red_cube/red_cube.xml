<mujoco model="red_cube">
  <asset>
  </asset>
  <worldbody>
    <body>
      <body name="object" pos="0 0 0">
        <!-- A simple 5cm red cube. Half-size = 0.025m in each axis.
             Center placed at z=0.025 so the bottom face rests at z=0. -->
        <geom type="box" size="0.025 0.025 0.025" pos="0 0 0.025"
              density="200" friction="0.95 0.3 0.1"
              solimp="0.998 0.998 0.001" solref="0.001 1"
              rgba="0.9 0.1 0.1 1" conaffinity="1" contype="1" group="0"/>
      </body>
      <!-- Reference sites used by robosuite for placement calculations.
           bottom_site marks the lowest point of the object (z=0). -->
      <site rgba="0 0 0 0" size="0.005" pos="0 0 0" name="bottom_site"/>
      <site rgba="0 0 0 0" size="0.005" pos="0 0 0.05" name="top_site"/>
      <site rgba="0 0 0 0" size="0.005" pos="0.025 0.025 0" name="horizontal_radius_site"/>
    </body>
  </worldbody>
</mujoco>
