<mujoco model="brown_box">
  <asset>
  </asset>
  <worldbody>
    <body>
      <body name="object" pos="0 0 0">
        <!-- Simple rectangular brown box made of 5 box primitives.
             Outer footprint: 12cm x 12cm. Wall thickness: 1cm. Height: 7cm.
             Interior: 10cm x 10cm x 6cm — wide enough to hold the 5cm cube. -->

        <!-- Bottom plate: 12cm x 12cm x 1cm, bottom face at z=0 -->
        <geom type="box" size="0.060 0.060 0.005" pos="0 0 0.005"
              density="500" friction="0.95 0.3 0.1"
              solimp="0.998 0.998 0.001" solref="0.001 1"
              rgba="0.55 0.35 0.15 1" group="0"/>

        <!-- Front wall (y+): 12cm wide, 1cm thick, 6cm tall -->
        <geom type="box" size="0.060 0.005 0.030" pos="0 0.055 0.040"
              density="500" friction="0.95 0.3 0.1"
              solimp="0.998 0.998 0.001" solref="0.001 1"
              rgba="0.55 0.35 0.15 1" group="0"/>

        <!-- Back wall (y-) -->
        <geom type="box" size="0.060 0.005 0.030" pos="0 -0.055 0.040"
              density="500" friction="0.95 0.3 0.1"
              solimp="0.998 0.998 0.001" solref="0.001 1"
              rgba="0.55 0.35 0.15 1" group="0"/>

        <!-- Left wall (x+): spans full depth including corners -->
        <geom type="box" size="0.005 0.060 0.030" pos="0.055 0 0.040"
              density="500" friction="0.95 0.3 0.1"
              solimp="0.998 0.998 0.001" solref="0.001 1"
              rgba="0.55 0.35 0.15 1" group="0"/>

        <!-- Right wall (x-) -->
        <geom type="box" size="0.005 0.060 0.030" pos="-0.055 0 0.040"
              density="500" friction="0.95 0.3 0.1"
              solimp="0.998 0.998 0.001" solref="0.001 1"
              rgba="0.55 0.35 0.15 1" group="0"/>

        <!-- Containment region: box volume inside the box used by the In predicate. -->
        <site type="box" pos="0 0 0.040" size="0.045 0.045 0.028"
              name="contain_region" rgba="0 0.8 0 0" group="0" quat="1 0 0 0"/>
      </body>
      <!-- Reference sites for robosuite placement: bottom at z=0 (table surface contact). -->
      <site rgba="0 0 0 0" size="0.005" pos="0 0 0" name="bottom_site"/>
      <site rgba="0 0 0 0" size="0.005" pos="0 0 0.070" name="top_site"/>
      <site rgba="0 0 0 0" size="0.005" pos="0.060 0 0" name="horizontal_radius_site"/>
    </body>
  </worldbody>
</mujoco>
